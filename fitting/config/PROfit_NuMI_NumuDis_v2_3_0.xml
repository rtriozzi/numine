<?xml version="1.0" ?>

<mode name="nu" />
<detector name="ICARUS" pot="3e+20"/>

<channel name="numu" plotname="1#muNp0#pi">
    <bins unit="Reconstructed Neutrino Energy [GeV]" edges="0.35 0.4 0.45 0.5 0.55 0.6 0.65 0.7 0.75 0.8 0.85 0.9 0.95 1. 1.1 1.2 1.3 1.4 1.5 1.75 2 2.5"/>
    <bins unit="True Neutrino Energy [GeV]" min="0" max="3" nbins="15"/>
    <bins unit="True L/E [km/GeV]" min="0" max="3.5" nbins="200" plot="false"/>
    <bins unit="Reconstructed Neutrino Energy [GeV]" edges="0.35 0.5 0.65 0.8 1. 1.5 2.5"/>
    <subchannel name="intime" plotname="Intime Cosmics" color="#FBBC04"/>
    <subchannel name="cos"    plotname="Cosmics"        color="#E37400"/>
    <subchannel name="nc"     plotname="NC"             color="#FF6961"/>
    <subchannel name="nuecc"  plotname="#nu_{e} CC"     color="#34A853"/>
    <subchannel name="numucc" plotname="#nu_{#mu} CC"   color="#99CCFF"/>
</channel>

<model tag="numudis">
    <rule index="0" name="No Osc"/>
    <rule index="1" name="Numu Dis"/>
    <parameter name="L/E" variable_index="2"/>
</model>

<MCFile treename="events/selectedNu" filename="/storage/gpfs_data/icarus/local/users/rtriozzi/nuedis/sbruce/cv/CNAF_CV_1muNp0pi_NuMI_wMEC.root" scale = "1.0" pot="4.57453e+20"> 
    <friend treename="events/multisigmaTree" />
    <friend treename="events/multisimTree" />
    <branch
        associated_subchannel = "nu_ICARUS_numu_nuecc"
        incl_systematics      = "true"
        model_rule            = "0"
        additional_weight     = "CC && (truePDG == 12 || truePDG == -12) && index >= 0"
    >
        <variable>recoE</variable>
        <variable>trueE</variable>
        <variable>trueL/(1000*trueE)</variable>
        <variable>recoE</variable>
    </branch>
    <branch
        associated_subchannel = "nu_ICARUS_numu_numucc"
        incl_systematics      = "true"
        model_rule            = "1"
        additional_weight     = "CC && (truePDG == 14 || truePDG == -14) && index >= 0"
    >
        <variable>recoE</variable>
        <variable>trueE</variable>
        <variable>trueL/(1000*trueE)</variable>
        <variable>recoE</variable>
    </branch>
    <branch
        associated_subchannel = "nu_ICARUS_numu_nc"
        incl_systematics      = "true"
        model_rule            = "1"
        additional_weight     = "CC == 0 && index >= 0"
    >
        <variable>recoE</variable>
        <variable>trueE</variable>
        <variable>trueL/(1000*trueE)</variable>
        <variable>recoE</variable>
    </branch>
</MCFile>
<MCFile treename="events/selectedCos" filename="/storage/gpfs_data/icarus/local/users/rtriozzi/nuedis/sbruce/cv/CNAF_CV_1muNp0pi_NuMI_wMEC.root" scale = "1.0" pot="4.57453e+20"> 
    <branch
        associated_subchannel = "nu_ICARUS_numu_cos"
        incl_systematics      = "false"
        model_rule            = "0"
        additional_weight     = "index < 0"
    >
        <variable>recoE</variable>
        <variable>0.0</variable>
        <variable>0.0</variable>
        <variable>recoE</variable>
    </branch>
</MCFile>
<MCFile treename="offbeam/selectedOffbeam" filename="/storage/gpfs_data/icarus/local/users/rtriozzi/nuedis/sbruce/data/CNAF_OffBeam_1muNp0pi_NuMI.root" scale = "1.0" pot="1e20"> 
    <branch
        associated_subchannel = "nu_ICARUS_numu_intime"
        incl_systematics      = "false"
        model_rule            = "0"
    >
        <variable>recoE</variable>
        <variable>0.0</variable>
        <variable>0.0</variable>
        <variable>recoE</variable>
    </branch>
</MCFile>

